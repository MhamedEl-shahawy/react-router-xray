{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "@react-router-xray/core#build"],
      "outputs": ["dist/**", "build/**", "target/**", "npm/**"]
    },
    "dev": {
      "dependsOn": ["@react-router-xray/core#build"],
      "cache": false
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    }
  }
}
