{
  "name": "@react-router-xray/react",
  "version": "1.0.0",
  "description": "React overlay components for live React Router route diagnostics and DOM highlighting.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/MhamedEl-shahawy/react-router-xray#readme",
  "bugs": {
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray/issues"
  },
  "keywords": [
    "react",
    "react-router",
    "devtools",
    "overlay",
    "routing"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@react-router-xray/core": "workspace:*",
    "react": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^8.4.7",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.3.10",
    "@types/react-dom": "^18.3.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
