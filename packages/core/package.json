{
  "name": "react-router-xray-core",
  "version": "2.0.1",
  "description": "Rust and TypeScript core analyzer for React Router route inspection and matching.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/MhamedEl-shahawy/react-router-xray#readme",
  "bugs": {
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray/issues"
  },
  "keywords": [
    "react-router",
    "wasm",
    "rust",
    "analysis",
    "router"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./wasm": {
      "types": "./dist/wasm.d.ts",
      "import": "./dist/wasm.js"
    }
  },
  "scripts": {
    "build": "pnpm run build:ts && pnpm run build:napi && pnpm run build:wasm",
    "build:ts": "tsc -p tsconfig.json",
    "build:napi": "napi build --platform --features napi",
    "build:wasm": "wasm-pack build --target web --out-dir ../../dist/wasm ./ -- --features wasm",
    "test": "cargo test --features cli,wasm,napi",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.4",
    "typescript": "^5.6.3"
  }
}
