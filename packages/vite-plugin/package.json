{
  "name": "vite-plugin-react-router-xray",
  "version": "2.0.3",
  "description": "Vite plugin for React Router analysis, virtual manifests, and dev instrumentation.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray.git",
    "directory": "packages/vite-plugin"
  },
  "homepage": "https://github.com/MhamedEl-shahawy/react-router-xray#readme",
  "bugs": {
    "url": "https://github.com/MhamedEl-shahawy/react-router-xray/issues"
  },
  "keywords": [
    "vite",
    "react-router",
    "plugin",
    "routing",
    "analysis"
  ],
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -w -p tsconfig.json",
    "test": "vitest run",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "react-router-xray-core": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@babel/parser": "^7.26.0",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/preset-typescript": "^7.26.0",
    "@babel/traverse": "^7.26.0",
    "@babel/types": "^7.26.0",
    "@types/babel__core": "^7.20.5",
    "@types/babel__traverse": "^7.20.7",
    "typescript": "^5.6.3",
    "vite": "^5.4.8",
    "vitest": "^2.1.3"
  }
}
